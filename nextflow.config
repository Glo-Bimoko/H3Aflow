/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow.config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/


dag.enabled = true // skip DAG generation if you don't need it — saves time and resources
timeline.enabled = true
report.enabled = true

//Avoid re-staging unchanged files
//nextflow.enable.moduleBinaries = true


params {
    samplesheet    = null
    idat_root      = null
    bpm            = null
    egt            = null
    fasta          = null
    mind           = 0.05
    snp_missing    = 0.05    //SNP missingness cutoff (--geno in plink)
    hwe            = 1e-4  //HWE p-value cutoff (--hwe in plink)
    het_sd         = 3
    maf            = 0.0001
    ibd_pi_hat     = 0.1875
    pca_components = 10
    outdir         = "${projectDir}/results"
    tracedir       = "${params.outdir}/pipeline_info"
}

// ── Base process defaults (fallback for any process not named below) ──────────
process {
    cpus   = 12
    memory = '24 GB'
    time   = '48h'


    withName: 'PREP_INPUTS'        { cpus = 1;  memory = '4 GB';   time = '1h'  }
    withName: 'LINK_IDATS'         { cpus = 1;  memory = '2 GB';   time = '1h'  }
    withName: 'GENERATE_PHENOFILE' { cpus = 1;  memory = '2 GB';   time = '30m' }
    withName: 'FILTER_SAMPLES'     { cpus = 1;  memory = '8 GB';   time = '1h'  }
    withName: 'IDAT_TO_GTC'        { cpus = 4;  memory = '24 GB';  time = '24h' }
    withName: 'GTC_TO_VCF'         { cpus = 8;  memory = '24 GB';  time = '8h'  }
    withName: 'VCF_TO_PLINK'       { cpus = 4;  memory = '16 GB';  time = '4h'  }
    withName: 'MERGE_PLINK'        { cpus = 12; memory = '64 GB';  time = '12h' }
    withName: 'SAMPLE_QC'          { cpus = 4;  memory = '16 GB';  time = '4h'  }
    withName: 'SNP_QC'             { cpus = 4;  memory = '16 GB';  time = '4h'  }
    withName: 'SPLIT_CHROM'        { cpus = 4;  memory = '16 GB';  time = '2h'  }
    withName: 'CHECK_SEX'          { cpus = 4;  memory = '16 GB';  time = '2h'  }
    withName: 'XY_INTENSITY'       { cpus = 4;  memory = '24 GB';  time = '2h'  }
    withName: 'IBD'                { cpus = 12; memory = '64 GB';  time = '12h' }
    withName: 'PCA'                { cpus = 12; memory = '24 GB';  time = '6h'  }
    withName: 'REPORT'             { cpus = 2;  memory = '8 GB';   time = '2h'  }
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {

    // ── Local execution ───────────────────────────────────────────────────────
    local {
        process.executor = 'local'
        executor.cpus    = 12     // cap total local parallelism
        
        process {
            withName: 'IDAT_TO_GTC' { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'GTC_TO_VCF'  {cpus = 4;  memory = '16 GB'; time = '8h'  }
            withName: 'MERGE_PLINK' { cpus = 8;  memory = '24 GB'; time = '12h' }
            withName: 'IBD'         { cpus = 8;  memory = '24 GB'; time = '12h' }
            withName: 'PCA'         { cpus = 8;  memory = '24 GB'; time = '6h'  }
        }

        env.BCFTOOLS_PLUGINS = "/home/eiko/Desktop/H3Aflow/bin/plugins/gtc2vcf"
        params {
            idat_root = "/home/eiko/Desktop/H3Aflow/prof_segun/data/ready"
            bpm       = "/home/eiko/Desktop/H3Aflow/bin/bpm_and_cluster/H3Africa_2019_20037295_A1.bpm"
            egt       = "/home/eiko/Desktop/H3Aflow/bin/bpm_and_cluster/H3Africa_2019_Gentrain_A1_ClusterFile_Final.egt"
            fasta     = "/home/eiko/Desktop/H3Aflow/GRCh37/human_g1k_v37.fasta"
            outdir    = "/home/eiko/Desktop/H3Aflow/results"
            tracedir  = "/home/eiko/Desktop/H3Aflow/results/pipeline_info"
        }
    }

    // ── CHPC Lengau ───────────────────────────────────────────────────────────
    chpc {
        process.executor         = 'pbs'
        process.queue            = 'serialllong'
        process.clusterOptions   = '-P add your own'


        // 12 means only 12 run at once. Raise to your project's job limit.
        executor.queueSize       = 10
        executor.submitRateLimit = '10/1min'   // raised from 5 — safe for most clusters

        process.beforeScript = """
            export NXF_WORK=/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/work
            export NXF_TEMP=/mnt/lustre/users/gbimoko/.nextflow_tmp
            module purge
            module load chpc/BIOMODULES
            module load plink/1.90
            module load bcftools/1.20
            module load libdeflate
            module load python/3.9.6
            module load R/4.2.0
            module load plink/2.00a
            module load java/24.0.1
        """

        env.BCFTOOLS_PLUGINS = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/plugins/gtc2vcf"

        params {
            idat_root = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/prof_segun/data/ready"
            bpm       = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/bpm_and_cluster/H3Africa_2019_20037295_A1.bpm"
            egt       = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/bpm_and_cluster/H3Africa_2019_Gentrain_A1_ClusterFile_Final.egt"
            fasta     = "/mnt/lustre/users/gbimoko/GRCh37/human_g1k_v37.fasta"
            outdir    = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/results"
            tracedir  = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/results/pipeline_info"
        }

        process {
            // Light bookkeeping stages run on the login/head node — no PBS overhead
            withName: 'PREP_INPUTS'        { executor = 'local'; cpus = 1; memory = '4 GB';  time = '1h'  }
            withName: 'LINK_IDATS'         { executor = 'local'; cpus = 1; memory = '2 GB';  time = '1h'  }
            withName: 'GENERATE_PHENOFILE' { executor = 'local'; cpus = 1; memory = '2 GB';  time = '30m' }
            withName: 'FILTER_SAMPLES'     { executor = 'local'; cpus = 1; memory = '8 GB';  time = '1h'  }

            // Per-sample conversion — each a separate PBS job, all run in parallel
            // cpus lowered to 4: bcftools +idat2gtc is mostly single-threaded;
            // requesting 12 wastes allocation and slows queue admission.
            withName: 'IDAT_TO_GTC'  { cpus = 8;  memory = '32 GB'; time = '8h'  }

            // Per-plate VCF generation — genuinely benefits from more cores
            withName: 'GTC_TO_VCF'   { cpus = 12; memory = '32 GB'; time = '8h'  }

            withName: 'VCF_TO_PLINK' { cpus = 8;  memory = '32 GB'; time = '4h'  }
            withName: 'MERGE_PLINK'  { cpus = 12; memory = '64 GB'; time = '12h' }
            withName: 'SAMPLE_QC'    { cpus = 8;  memory = '16 GB'; time = '4h'  }
            withName: 'SNP_QC'       { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'SPLIT_CHROM'  { cpus = 4;  memory = '16 GB'; time = '2h'  }
            withName: 'CHECK_SEX'    { cpus = 4;  memory = '16 GB'; time = '2h'  }
            withName: 'XY_INTENSITY' { cpus = 4;  memory = '16 GB'; time = '2h'  }
            withName: 'IBD'          { cpus = 12; memory = '64 GB'; time = '12h' }
            withName: 'PCA'          { cpus = 12; memory = '32 GB'; time = '6h'  }
            withName: 'REPORT'       { cpus = 2;  memory = '8 GB';  time = '2h'  }
        }
    }

    // ── PBS (gpu_1 queue) ─────────────────────────────────────────────────────
    pbs {
        process.executor         = 'pbs'
        process.queue            = 'gpu_1'
        process.clusterOptions   = '-P add your own'
        // 12 means only 12 run at once. Raise to your project's job limit.
        executor.queueSize       = 10
        executor.submitRateLimit = '10/1min'

        process.beforeScript = """
            export NXF_WORK=/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/work
            export NXF_TEMP=/mnt/lustre/users/gbimoko/.nextflow_tmp
            module purge
            module load libdeflate
            module load plink/1.90
            module load chpc/nextflow/25.04.4
            module load python/3.9.6
            module load chpc/BIOMODULES
            module load bcftools/1.20
            module load R/4.2.0
            module load plink/2.00a
            module load java/24.0.1
        """

        env.BCFTOOLS_PLUGINS = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/plugins/gtc2vcf"

        params {
            idat_root = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/prof_segun/data/ready"
            bpm       = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/bpm_and_cluster/H3Africa_2019_20037295_A1.bpm"
            egt       = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/bpm_and_cluster/H3Africa_2019_Gentrain_A1_ClusterFile_Final.egt"
            fasta     = "/mnt/lustre/users/gbimoko/GRCh37/human_g1k_v37.fasta"
            outdir    = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/results"
            tracedir  = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/results/pipeline_info"
        }

        process {
            withName: 'PREP_INPUTS'        { executor = 'local'; cpus = 1; memory = '4 GB';  time = '1h'  }
            withName: 'LINK_IDATS'         { executor = 'local'; cpus = 1; memory = '2 GB';  time = '1h'  }
            withName: 'GENERATE_PHENOFILE' { executor = 'local'; cpus = 1; memory = '2 GB';  time = '30m' }
            withName: 'FILTER_SAMPLES'     { executor = 'local'; cpus = 1; memory = '8 GB';  time = '1h'  }

            withName: 'IDAT_TO_GTC'  { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'GTC_TO_VCF'   { cpus = 12; memory = '32 GB'; time = '8h'  }
            withName: 'VCF_TO_PLINK' { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'MERGE_PLINK'  { cpus = 12; memory = '64 GB'; time = '12h' }
            withName: 'SAMPLE_QC'    { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'SNP_QC'       { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'SPLIT_CHROM'  { cpus = 4;  memory = '16 GB'; time = '2h'  }
            withName: 'CHECK_SEX'    { cpus = 4;  memory = '16 GB'; time = '2h'  }
            withName: 'XY_INTENSITY' { cpus = 4;  memory = '16 GB'; time = '2h'  }
            withName: 'IBD'          { cpus = 12; memory = '64 GB'; time = '12h' }
            withName: 'PCA'          { cpus = 12; memory = '32 GB'; time = '6h'  }
            withName: 'REPORT'       { cpus = 2;  memory = '8 GB';  time = '2h'  }
        }
    }

}  // ← closes profiles


// ── Reporting ─────────────────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
}

trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace.txt"
}

dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag.svg"
}
