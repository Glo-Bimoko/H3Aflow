/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow.config  —  H3Aflow
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Queue strategy (CHPC Lengau):
      seriallong : main queue — long single-node jobs (max 12 cores, 144h, 10 running)
      serial     : downstream QC steps (max 23 cores, 48h, 10 running)
      smp        : memory-heavy single-node jobs (min 24 cores, 96h, 10 running)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

dag.enabled      = true
timeline.enabled = true
report.enabled   = true

params {
    samplesheet    = null
    idat_root      = null
    bpm            = null
    egt            = null
    fasta          = null

    // ── Python interpreter ────────────────────────────────────────────────────
    // Set per-profile below so local desktop and CHPC each point to their own
    // conda env Python. All .nf scripts reference ${params.python} so no paths
    // are hardcoded in process definitions.
    python         = "python"   // safe fallback — overridden by every profile

    // ── Sample / SNP QC ──────────────────────────────────────────────────────
    mind           = 0.05       // sample call-rate cutoff (fail if > 5 % missing)
    snp_missing    = 0.05       // SNP missingness cutoff (--geno)
    hwe            = 1e-4       // HWE p-value filter (autosomes)
    het_sd         = 3          // heterozygosity SD cutoff
    maf            = 0.0001     // autosomal MAF filter
    ibd_pi_hat     = 0.1875     // PI_HAT threshold for flagging related pairs
    pca_components = 10         // number of principal components

    // ── GTC-level QC (early sample filtering) ─────────────────────────────────
    gc10_threshold          = 0.15   // minimum p10_gc (GenCall @ 10% threshold)
    call_rate_threshold     = 0.95   // minimum call rate at GTC level

    outdir         = "${projectDir}/results"
    tracedir       = "${params.outdir}/pipeline_info"

    // ── Genotype concordance ──────────────────────────────────────────────────
    concordance_chunk      = 50000   // SNPs streamed per chunk; controls peak RAM
    concordance_dup_thresh = 99.5    // % concordance → flag as likely duplicate
    concordance_warn       = 84      // % concordance → warning
    concordance_flag       = 99      // % concordance → flag

    // ══════════════════════════════════════════════════════════════════════════
    // Sex check parameters
    // ══════════════════════════════════════════════════════════════════════════

    // ── F-statistic thresholds (H3AGWAS: f_lo_male / f_hi_female) ────────────
    // PLINK --check-sex calls:
    //   Male    if F > f_lo_male   (default PLINK: 0.8)
    //   Female  if F < f_hi_female (default PLINK: 0.2)
    //   PROBLEM if neither condition is met.
    // H3AGWAS defaults match PLINK defaults and are appropriate for most arrays.
    // Tighten (e.g. 0.9 / 0.1) only for very large, high-quality cohorts.
    f_lo_male   = 0.8
    f_hi_female = 0.2

    // ── chrX SNP QC thresholds (H3AGWAS stats_x.py approach) ─────────────────
    //
    // The seven filters below replicate H3AGWAS stats_x.py and are applied in
    // check_sex.nf Step 5 before --check-sex.  Understanding the dataset split
    // is critical:
    //
    //   chrX_hhmissing  =  chrX after --set-hh-missing
    //                      Male het-haploid calls → missing.
    //                      Used for male freq + missingness AND for --check-sex.
    //
    //   chrX_sexed      =  chrX before --set-hh-missing
    //                      Females are diploid throughout; HWE is valid here.
    //                      Used for female freq + missingness + HWE.
    //
    // WHY SPLIT THE DATASET?
    //   On non-PAR chrX, males are hemizygous.  Illumina arrays often produce
    //   heterozygous calls for males at these sites (het-haploid).  PLINK
    //   --set-hh-missing converts these to missing, which is biologically correct
    //   but dramatically increases male missingness at non-PAR X sites.
    //
    //   Previous bug: male missingness was measured from chrX_sexed (pre-null),
    //   where het-haploid calls appear as called genotypes (missingness ≈ 0 %).
    //   The x_miss_male = 0.02 filter therefore passed nearly all SNPs.
    //   Post-nulling, those same SNPs are now massively missing in males, but
    //   the filter had already passed them.  The surviving SNPs had valid female
    //   heterozygosity but drove male F to 0 — all females appeared male (F≈1)
    //   because the SNP set was uninformative for females.
    //
    //   Fix: measure male missingness from chrX_hhmissing (post-null), so
    //   x_miss_male reflects what --check-sex actually sees.
    //
    // ── x_maf_male ────────────────────────────────────────────────────────────
    // Minimum MAF in MALES on chrX, measured from chrX_hhmissing.
    // After --set-hh-missing, many non-PAR SNPs will have very low allele counts
    // in males (only homozygous calls remain), so MAF naturally falls.
    // 0.01 is a reasonable lower bound; lower this to 0.001 if few SNPs survive.
    x_maf_male    = 0.01

    // ── x_maf_female ──────────────────────────────────────────────────────────
    // Minimum MAF in FEMALES on chrX, measured from chrX_sexed (diploid).
    // Standard MAF filter; 0.01 is the H3AGWAS default.
    x_maf_female  = 0.01

    // ── x_miss_male ───────────────────────────────────────────────────────────
    // Maximum missingness in MALES, measured from chrX_hhmissing (post-null).
    //
    // After --set-hh-missing, non-PAR X sites that were heterozygous in males
    // become missing.  On the H3Africa 2019 array, which has dense non-PAR X
    // coverage, post-null male missingness on non-PAR X is typically 40–80 %.
    // Setting x_miss_male = 0.8 retains SNPs where at most 80 % of male calls
    // were nulled.  Sites above 0.8 are near-completely uninformative in males
    // and are removed; the Fisher test handles the rest.
    //
    // If too few SNPs survive, increase this to 0.9.
    // If you want only sites with good male coverage, decrease to 0.5.
    x_miss_male   = 0.8

    // ── x_miss_female ─────────────────────────────────────────────────────────
    // Maximum missingness in FEMALES, measured from chrX_sexed (diploid, pre-null).
    // Females are unaffected by --set-hh-missing.
    // 0.05 is a standard threshold; 0.02 (H3AGWAS default) is stricter.
    x_miss_female = 0.05

    // ── x_diff_miss ───────────────────────────────────────────────────────────
    // Maximum absolute difference between post-null male missingness and
    // pre-null female missingness: |miss_male_postnull - miss_female_prenull|.
    //
    // Previous default was 0.02 (H3AGWAS, applied to pre-null data for both).
    // With the corrected split (male post-null, female pre-null), a large
    // difference is *expected* for non-PAR X sites (males are missing, females
    // are not).  Setting x_diff_miss = 0.6 flags only extreme outliers that may
    // indicate PAR-boundary misassignment or other artefacts, while retaining
    // the biologically meaningful non-PAR X SNPs.
    //
    // Decrease toward 0.1 only if you have good PAR separation (--split-x
    // successfully reclassified SNPs) and want tighter artefact filtering.
    x_diff_miss   = 0.6

    // ── x_hwe_female ──────────────────────────────────────────────────────────
    // HWE p-value threshold applied to FEMALES ONLY on chrX.
    // Males are hemizygous so HWE is not defined for them.
    // 1e-4 is the H3AGWAS default; matches the autosomal HWE param above.
    x_hwe_female  = 1e-4

    // ── x_fisher_p ────────────────────────────────────────────────────────────
    // Fisher's exact test threshold for comparing allele frequency between
    // males and females on chrX (H3AGWAS stats_x.py default: 1e-4).
    // SNPs with a highly significant frequency difference between sexes are
    // flagged as potential PAR-proximal artefacts or genotyping errors and
    // removed.  This is the primary guard against residual PAR contamination
    // when --split-x does not reclassify any SNPs (e.g. the H3Africa array
    // has no probes in the strict PAR1/PAR2 boundaries).
    x_fisher_p    = 1e-4

    // ── Multi-missingness sex check thresholds (H3AGWAS xCheck.py) ──────────────
    // --check-sex is re-run at each --mind threshold below.
    // Samples discordant at ALL thresholds = hard discordant (label error).
    // Samples that flip between OK and discordant = missingness-driven uncertainty.
    // Comma-separated list; matches H3AGWAS default of 0.01,0.03,0.05.
    // Add 0.1 to also catch very high-missingness samples explicitly.
    sex_mind_thresholds = "0.01,0.03,0.05,0.1"
}

// ── Base process defaults (fallback for processes not named below) ────────────
process {
    cpus   = 8
    memory = '16 GB'
    time   = '48h'

    withName: 'PREP_INPUTS'            { cpus = 1;  memory = '4 GB';  time = '1h'  }
    withName: 'LINK_IDATS'             { cpus = 1;  memory = '2 GB';  time = '1h'  }
    withName: 'GENERATE_PHENOFILE'     { cpus = 1;  memory = '2 GB';  time = '30m' }
    withName: 'FILTER_SAMPLES'         { cpus = 1;  memory = '8 GB';  time = '1h'  }
    withName: 'IDAT_TO_GTC'            { cpus = 8;  memory = '32 GB'; time = '8h'  }
    withName: 'GTC_TO_VCF'             { cpus = 12; memory = '32 GB'; time = '8h'  }
    withName: 'VCF_TO_PLINK'           { cpus = 8;  memory = '16 GB'; time = '4h'  }
    withName: 'MERGE_PLINK'            { cpus = 24; memory = '64 GB'; time = '12h' }
    withName: 'SAMPLE_QC'              { cpus = 8;  memory = '16 GB'; time = '4h'  }
    withName: 'SNP_QC'                 { cpus = 4;  memory = '16 GB'; time = '4h'  }
    withName: 'GENOTYPE_CONCORDANCE'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'CHECK_SEX'              { cpus = 1;  memory = '4 GB';  time = '30m' }
    withName: 'IBD'                    { cpus = 24; memory = '64 GB'; time = '12h' }
    withName: 'PCA'                    { cpus = 24; memory = '32 GB'; time = '6h'  }
    withName: 'REPORT'                 { cpus = 2;  memory = '8 GB';  time = '2h'  }
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {

    // ── Local execution (desktop / laptop testing) ────────────────────────────
    local {
        process.executor = 'local'
        executor.cpus    = 12

        process {
            withName: 'IDAT_TO_GTC'          { cpus = 4; memory = '16 GB'; time = '4h'  }
            withName: 'GTC_TO_VCF'           { cpus = 4; memory = '16 GB'; time = '8h'  }
            withName: 'MERGE_PLINK'          { cpus = 8; memory = '24 GB'; time = '12h' }
            withName: 'GENOTYPE_CONCORDANCE' { cpus = 4; memory = '8 GB';  time = '2h'  }
            withName: 'IBD'                  { cpus = 8; memory = '24 GB'; time = '12h' }
            withName: 'PCA'                  { cpus = 8; memory = '24 GB'; time = '6h'  }
        }

        // Both plugin dirs must be in BCFTOOLS_PLUGINS:
        //   1. standard bcftools libexec  → +setGT, +fill-tags, etc.
        //   2. gtc2vcf plugin dir         → +gtc2vcf
        // Colon-separated, standard dir FIRST so +setGT is always found.
        env.BCFTOOLS_PLUGINS = "/usr/local/libexec/bcftools:${projectDir}/bin/plugins/gtc2vcf"
        env.BCFTOOLS_LIBEXEC = "/usr/local/libexec/bcftools"

        params {
            python    = "/home/eiko/miniforge3/envs/genomics/bin/python"
            idat_root = "${projectDir}/prof_segun/data/ready"
            bpm       = "${projectDir}/bin/bpm_and_cluster/H3Africa_2019_20037295_A1.bpm"
            egt       = "${projectDir}/bin/bpm_and_cluster/H3Africa_2019_Gentrain_A1_ClusterFile_Final.egt"
            fasta     = "${projectDir}/GRCh37/human_g1k_v37.fasta"
            outdir    = "${projectDir}/results"
            tracedir  = "${projectDir}/results/pipeline_info"
        }
    }

    // ── CHPC Lengau ───────────────────────────────────────────────────────────
    chpc {
        process.executor         = 'pbs'
        process.queue            = 'seriallong'
        process.clusterOptions   = '-P add your own'

        executor.queueSize       = 20
        executor.submitRateLimit = '10/1min'
        executor.cpus            = 30

        process.beforeScript = """
            export NXF_WORK=/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/work
            export NXF_TEMP=/mnt/lustre/users/gbimoko/.nextflow_tmp
            module load chpc/BIOMODULES
            module load bcftools/1.20
            module load java/24.0.1
            module load plink/2.00a
            module load libdeflate
            module load plink/1.90
            module load R/4.2.0
            module load chpc/nextflow/25.04.4
            module load bwa/0.7.17
            module load htslib/1.23.1
            module load samtools/1.20
            source /home/gbimoko/miniforge3/etc/profile.d/conda.sh
            conda activate /mnt/lustre/users/gbimoko/conda_envs/H3AFlow
        """

        env.BCFTOOLS_PLUGINS = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/plugins/gtc2vcf"
        env.BCFTOOLS_LIBEXEC = "/apps/chpc/bio/bcftools/1.20/libexec/bcftools"

        params {
            python    = "/mnt/lustre/users/gbimoko/conda_envs/H3AFlow/bin/python"
            idat_root = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/prof_segun/data/ready"
            bpm       = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/bpm_and_cluster/H3Africa_2019_20037295_A1.bpm"
            egt       = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/bpm_and_cluster/H3Africa_2019_Gentrain_A1_ClusterFile_Final.egt"
            fasta     = "/mnt/lustre/users/gbimoko/GRCh37/human_g1k_v37.fasta"
            outdir    = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/results"
            tracedir  = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/results/pipeline_info"
        }

        process {
            // ── Light bookkeeping — run locally on the head node ──────────────
            withName: 'PREP_INPUTS'        { executor = 'local'; cpus = 1; memory = '4 GB';  time = '1h'  }
            withName: 'LINK_IDATS'         { executor = 'local'; cpus = 1; memory = '2 GB';  time = '1h'  }
            withName: 'GENERATE_PHENOFILE' { executor = 'local'; cpus = 1; memory = '2 GB';  time = '30m' }
            withName: 'FILTER_SAMPLES'     { executor = 'local'; cpus = 1; memory = '8 GB';  time = '1h'  }
            withName: 'SEED_GTC'           { executor = 'pbs'; cpus = 1; memory = '2 GB';  time = '30m' }

            // ── Per-sample PBS jobs: rotate across serial → seriallong → smp ──
            // smp requires min 24 cores, so these processes use 24 cpus when
            // they land on smp (task.index % 3 == 2) and fewer otherwise.
            // The queue rotation spreads load evenly across all three queues.

            withName: 'IDAT_TO_GTC' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 8 }
                memory = '32 GB'
                time   = '8h'
            }

            withName: 'GTC_QC' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 12 }
                memory = '32 GB'
                time   = '8h'
            }

            withName: 'GTC_TO_VCF' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 12 }
                memory = '32 GB'
                time   = '8h'
            }

            withName: 'VCF_TO_PLINK' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 8 }
                memory = '16 GB'
                time   = '4h'
            }

            // ── Single-instance cohort jobs: rotate across all three queues ───
            // These run once (no per-sample parallelism), so task.index is
            // always 1. Assign them explicitly to spread load.

            withName: 'MERGE_PLINK' {
                queue  = 'smp'   // always needs ≥ 24 cores — smp only
                cpus   = 24
                memory = '64 GB'
                time   = '12h'
            }

            withName: 'SAMPLE_QC' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 8 }
                memory = '16 GB'
                time   = '4h'
            }

            withName: 'SNP_QC' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 4 }
                memory = '16 GB'
                time   = '4h'
            }

            withName: 'GENOTYPE_CONCORDANCE' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 4 }
                memory = '8 GB'
                time   = '2h'
            }

            withName: 'IBD' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 12 }
                memory = '64 GB'
                time   = '12h'
            }

            withName: 'PCA' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 12 }
                memory = '32 GB'
                time   = '6h'
            }

            withName: 'FILTER_GTC_SAMPLES' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 1 }
                memory = '4 GB'
                time   = '30m'
            }

            withName: 'CHECK_SEX' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 1 }
                memory = '4 GB'
                time   = '30m'
            }

            withName: 'REPORT' {
                queue  = { (task.index % 3 == 0) ? 'serial'     :
                           (task.index % 3 == 1) ? 'seriallong' : 'smp' }
                cpus   = { (task.queue == 'smp')  ? 24 : 2 }
                memory = '8 GB'
                time   = '2h'
            }
        }
    }

    // ── PBS gpu_1 queue ───────────────────────────────────────────────────────
    pbs {
        process.executor         = 'pbs'
        process.queue            = 'gpu_1'
        process.clusterOptions   = '-P add your own'
        executor.queueSize       = 10
        executor.submitRateLimit = '10/1min'

        process.beforeScript = """
            export NXF_WORK=/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/work
            export NXF_TEMP=/mnt/lustre/users/gbimoko/.nextflow_tmp
            module load chpc/BIOMODULES
            module load bcftools/1.20
            module load java/24.0.1
            module load plink/2.00a
            module load libdeflate
            module load plink/1.90
            module load R/4.2.0
            module load chpc/nextflow/25.04.4
            module load bwa/0.7.17
            module load htslib/1.23.1
            module load samtools/1.20
            source /home/gbimoko/miniforge3/etc/profile.d/conda.sh
            conda activate /mnt/lustre/users/gbimoko/conda_envs/H3AFlow
        """

        env.BCFTOOLS_PLUGINS = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/plugins/gtc2vcf"
        env.BCFTOOLS_LIBEXEC = "/apps/chpc/bio/bcftools/1.20/libexec/bcftools"

        params {
            python    = "/mnt/lustre/users/gbimoko/conda_envs/H3AFlow/bin/python"
            idat_root = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/prof_segun/data/ready"
            bpm       = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/bpm_and_cluster/H3Africa_2019_20037295_A1.bpm"
            egt       = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/bpm_and_cluster/H3Africa_2019_Gentrain_A1_ClusterFile_Final.egt"
            fasta     = "/mnt/lustre/users/gbimoko/GRCh37/human_g1k_v37.fasta"
            outdir    = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/results"
            tracedir  = "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/results/pipeline_info"
        }

        process {
            withName: 'PREP_INPUTS'          { executor = 'local'; cpus = 1; memory = '4 GB';  time = '1h'  }
            withName: 'LINK_IDATS'           { executor = 'local'; cpus = 1; memory = '2 GB';  time = '1h'  }
            withName: 'GENERATE_PHENOFILE'   { executor = 'local'; cpus = 1; memory = '2 GB';  time = '30m' }
            withName: 'FILTER_SAMPLES'       { executor = 'local'; cpus = 1; memory = '8 GB';  time = '1h'  }
            withName: 'IDAT_TO_GTC'          { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'GTC_TO_VCF'           { cpus = 12; memory = '32 GB'; time = '8h'  }
            withName: 'VCF_TO_PLINK'         { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'MERGE_PLINK'          { cpus = 12; memory = '64 GB'; time = '12h' }
            withName: 'SAMPLE_QC'            { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'SNP_QC'               { cpus = 4;  memory = '16 GB'; time = '4h'  }
            withName: 'GENOTYPE_CONCORDANCE' { cpus = 4;  memory = '8 GB';  time = '2h'  }
            withName: 'CHECK_SEX'            { cpus = 1;  memory = '4 GB';  time = '30m' }
            withName: 'IBD'                  { cpus = 12; memory = '64 GB'; time = '12h' }
            withName: 'PCA'                  { cpus = 12; memory = '32 GB'; time = '6h'  }
            withName: 'REPORT'               { cpus = 2;  memory = '8 GB';  time = '2h'  }
        }
    }

}  // ← closes profiles


// ── Reporting ─────────────────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
}

trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace.txt"
}

dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag.svg"
}