#!/bin/bash
#head job needs very little resources to orchestrate child jobs
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=144:00:00
#PBS -q seriallong

#PBS -P add your own  
#PBS -o /mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/logs/pipeline_stdout.txt
#PBS -e /mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/logs/pipeline_stderr.txt
#PBS -N H3aFlow 
#PBS -M glory.bimoko@cpgr.org.za
#PBS -m abe

# ── Conda env sync ────────────────────────────────────────────────────────────
# Lustre is purged every 90 days; this block auto-clones H3AFlow if missing.
# Source conda from the stable home-dir miniforge3 installation.
source /home/gbimoko/miniforge3/etc/profile.d/conda.sh

CONDA_ENV_SRC=/home/gbimoko/miniforge3/envs/H3AFlow
CONDA_ENV_DST=/mnt/lustre/users/gbimoko/conda_envs/H3AFlow

if [ ! -d "${CONDA_ENV_DST}" ]; then
    echo "INFO: Lustre conda env not found — cloning from ${CONDA_ENV_SRC} ..."
    mkdir -p /mnt/lustre/users/gbimoko/conda_envs
    conda create --prefix "${CONDA_ENV_DST}" --clone "${CONDA_ENV_SRC}" -y
    echo "INFO: Conda env clone complete."
else
    echo "INFO: Lustre conda env found at ${CONDA_ENV_DST} — skipping clone."
fi

# ── Load modules ──────────────────────────────────────────────────────────────
module load chpc/BIOMODULES
module load bcftools/1.20
module load java/24.0.1
module load plink/2.00a
module load libdeflate
module load plink/1.90
module load R/4.2.0
module load chpc/nextflow/25.04.4
module load bwa/0.7.17
module load htslib/1.23.1
module load samtools/1.20

# ── Environment ───────────────────────────────────────────────────────────────
export BCFTOOLS_PLUGINS=/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/bin/plugins/gtc2vcf
#export NXF_HOME=/mnt/lustre/users/gbimoko/.nextflow
export NXF_TEMP=/mnt/lustre/users/gbimoko/.nextflow_tmp
export NXF_WORK=/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/work
mkdir -p ${NXF_WORK} ${NXF_TEMP} ${NXF_HOME}

# ── Paths ─────────────────────────────────────────────────────────────────────
PIPELINE_DIR=/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline
SAMPLESHEET=/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/filtered_all_plates_samples.csv

# ── Pre-flight checks ─────────────────────────────────────────────────────────
for f in "$SAMPLESHEET" \
    "${PIPELINE_DIR}/bin/bpm_and_cluster/H3Africa_2019_20037295_A1.bpm" \
    "${PIPELINE_DIR}/bin/bpm_and_cluster/H3Africa_2019_Gentrain_A1_ClusterFile_Final.egt" \
    "/mnt/lustre/users/gbimoko/GRCh37/human_g1k_v37.fasta"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: Required file not found: $f" >&2
        exit 1
    fi
done

if [ ! -d "/mnt/lustre/users/gbimoko/idat2vcf-pipeline/idat2vcf-pipeline/prof_segun/data/ready" ]; then
    echo "ERROR: idat root not found" >&2
    exit 1
fi

# Verify bcftools plugin loads
bcftools +idat2gtc 2>&1 | grep -q "bpm option" || {
    echo "ERROR: bcftools +idat2gtc plugin not loading correctly" >&2
    exit 1
}

# ── Setup ─────────────────────────────────────────────────────────────────────
mkdir -p ${PIPELINE_DIR}/logs
cd ${PIPELINE_DIR}

echo "=========================================="
echo " H3aFlow Pipeline"
echo " Start : $(date)"
echo " Job   : ${PBS_JOBID}"
echo " Node  : $(hostname)"
echo " CPUs  : $(nproc)"
echo "=========================================="

# ── Run pipeline ──────────────────────────────────────────────────────────────
nextflow run main.nf \
    --samplesheet "${SAMPLESHEET}" \
    -profile chpc \
    -work-dir "${NXF_WORK}" \
    -resume \
    -with-trace   "${PIPELINE_DIR}/logs/trace.txt" \
    -with-report  "${PIPELINE_DIR}/logs/report.html" \
    -with-timeline "${PIPELINE_DIR}/logs/timeline.html" \
    2>&1 | tee "${PIPELINE_DIR}/logs/nextflow_run.log"

NXF_EXIT=${PIPESTATUS[0]}

echo "=========================================="
echo " End    : $(date)"
echo " Status : ${NXF_EXIT}"
echo "=========================================="

exit ${NXF_EXIT}